availability_domain                                 = "RiYU:EU-FRANKFURT-1-AD-1"
compartment_ocid                                    = "ocid1.compartment.oc1..replace"
subnet_ocid                                         = "ocid1.subnet.oc1..replace"
base_image_ocid                                     = "ocid1.image.oc1.eu-frankfurt-1.<official-oke-ol8-or-ol9-oke-image-ocid>"
oracle_linux_major_version                          = 8
k8s_version                                         = "1.36.1"

# Version-specific fast-start image set. Refresh this from a fresh-node pull
# observation whenever you change k8s_version or the underlying OKE system
# image set.
oke_default_prepull_images                          = [
  "eu-frankfurt-1.ocir.io/<system-namespace>/oke-public-vcn-native-ip-cni-plugin:<cni-tag>",
  "eu-frankfurt-1.ocir.io/<system-namespace>/oke-public-cloud-provider-oci:<cloud-provider-tag>",
  "eu-frankfurt-1.ocir.io/<aux-namespace>/oke-public-proxymux-cli:<proxymux-tag>",
  # Add kube-proxy here when OKE exposes it only as a digest-pinned ref.
  # "eu-frankfurt-1.ocir.io/<namespace>/oke-public-kube-proxy@sha256:<digest>",
  # Add pause here only if you need an explicit pinned ref.
  # "eu-frankfurt-1.ocir.io/<namespace>/oke-public-pause@sha256:<digest>",
]

# Optional workload- or workaround-specific extra images.
# additional_prepull_images                         = [
#   "public.ecr.aws/z2c7x8q5/bitnami/kubectl@sha256:78726c39c86a468752790cd392839cef1282095400bb3cdf3619ab5dae9c8d2c"
# ]
